DATABASE_URL="file:./dev.db"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# --- Production (Turso) ---
# Set these instead of the local file: URL when deploying. PrismaService
# switches to the libSQL driver adapter automatically when DATABASE_URL
# starts with "libsql://" or "https://".
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<token from: turso db tokens create <db-name>>"
