{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/jest.global-setup.ts",
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "maxWorkers": 1,
  "testTimeout": 15000
}
